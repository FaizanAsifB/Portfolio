---
import ProjectCard from '@/components/ProjectCard.astro'
import { getCollection } from 'astro:content'
const projectEntries = await getCollection('projects')
const sortedProjects = [...projectEntries].sort((a,b)=>a.data.gridPosition - b.data.gridPosition)
---

<section id='projects'>
  <div class='container space-y-16 overflow-x-clip'>
    <h2>My Projects</h2>
    <ul class='grid gap-8 md:grid-cols-2 lg:grid-cols-1 lg:gap-12 xl:gap-14'>
      {
        sortedProjects?.map((project, index) => (
          <li>
            <ProjectCard project={project} isEven={index % 2 !== 0} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
